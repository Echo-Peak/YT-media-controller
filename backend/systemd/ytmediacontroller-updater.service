[Unit]
Description=YT Media Controller Updater Service
After=network.target ytmediacontroller.service
Requires=ytmediacontroller.service

[Service]
Type=simple
ExecStart=/usr/bin/YTMediaControllerUpdaterSrv
WorkingDirectory=/opt/ytmediacontroller
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
